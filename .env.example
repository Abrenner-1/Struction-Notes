# Server-only Gemini AI API key used by AI-assisted workflows.
# Do not expose this as a VITE_ value.
GEMINI_API_KEY="your_gemini_api_key"

# Optional app URL for hosted deployments and self-referential links.
APP_URL="http://localhost:3000"

# Firebase configuration.
# The app has development defaults, but production deployments should provide these explicitly.
FIREBASE_PROJECT_ID=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
